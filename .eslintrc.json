{
    "env": {
        "browser": true,
        "es6": true
    },
    "extends": ["eslint:recommended", "google"],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly",
        "Gerrit": false,
        "Polymer": false
    },
    "parserOptions": {
        "ecmaVersion": 2018,
        "sourceType": "module"
    },
    "rules": {
        "max-len": [
            "error",
            80,
            2,
            {
                "ignoreComments": true,
                "ignorePattern": "^import .*;$",
                "ignoreUrls": true
            }
        ],
        "require-jsdoc": "off",
        "valid-jsdoc": "off"
    }
}
